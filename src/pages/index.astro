<script>
  // Pure Vanilla client-side interactive lang filtering for featured cards
  const cards = document.querySelectorAll('.featured-resource-card');

  function filterFeaturedCards() {
    const activeLang = localStorage.getItem('language') || 'es';
    let visibleCount = 0;
    
    cards.forEach(card => {
      const cardLang = card.getAttribute('data-lang') || 'es';
      // Only display matching language and up to 3 cards
      if (cardLang === activeLang && visibleCount < 3) {
        card.classList.remove('hidden');
        card.classList.add('flex');
        visibleCount++;
      } else {
        card.classList.remove('flex');
        card.classList.add('hidden');
      }
    });
  }

  // Run on load
  filterFeaturedCards();

  // Run on language changes
  window.addEventListener('languageChanged', () => {
    filterFeaturedCards();
  });

  // Modal toggle scripts attached to window securely for global access
  (window as any).openCertModal = function(title: string, imgSrc: string, desc: string, verifyLink: string, downloadSrc?: string, downloadName?: string) {
    const modal = document.getElementById('cert-modal');
    const modalContent = modal?.querySelector('div');
    const mTitle = document.getElementById('modal-cert-title');
    const mImg = document.getElementById('modal-cert-img') as HTMLImageElement;
    const mDesc = document.getElementById('modal-cert-desc');
    const mVerify = document.getElementById('modal-cert-verify-link') as HTMLAnchorElement;
    const mDownload = document.getElementById('modal-cert-download') as HTMLAnchorElement;

    if (modal && modalContent) {
      if (mTitle) mTitle.textContent = title;
      if (mImg) mImg.src = imgSrc;
      if (mDesc) mDesc.textContent = desc;
      if (mVerify) {
        mVerify.href = verifyLink;
        mVerify.classList.toggle('hidden', !verifyLink);
      }
      if (mDownload) {
        const fileSrc = downloadSrc || imgSrc;
        mDownload.href = fileSrc;
        mDownload.setAttribute('download', downloadName || `${title.replace(/\s+/g, '_')}.png`);
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      
      // Animate opening
      setTimeout(() => {
        modalContent.classList.remove('scale-95', 'opacity-0');
        modalContent.classList.add('scale-100', 'opacity-100');
      }, 50);
    }
  };

  (window as any).closeCertModal = function() {
    const modal = document.getElementById('cert-modal');
    const modalContent = modal?.querySelector('div');

    if (modal && modalContent) {
      modalContent.classList.remove('scale-100', 'opacity-100');
      modalContent.classList.add('scale-95', 'opacity-0');
      
      // Delay to complete CSS transition
      setTimeout(() => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
      }, 250);
    }
  };
</script>
