---
import Layout from './Layout.astro';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  pubDate?: Date | string;
  category?: string;
  badge?: string;
}

const { title, description, pubDate, category, badge = "LAB_REPORT // #001" } = Astro.props;

// Format the date if it exists
const formattedDate = pubDate
  ? new Date(pubDate).toLocaleDateString('es-ES', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : "Actualizado recientemente";
---

<Layout title={`${title} | Cristian Castillo`} description={description}>
  <main class="max-w-3xl mx-auto px-6 py-12 md:py-20 relative">
    
    <!-- Back Button -->
    <a href={withBase('/recursos')} class="inline-flex items-center gap-2 text-sm font-semibold text-slate-400 dark:text-slate-400 hover:text-blue-500 dark:hover:text-blue-400 transition-colors mb-8 group">
      <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span data-key="nav-back">Volver a Recursos</span>
    </a>

    <!-- Article -->
    <article class="relative">
      <!-- Decorative badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-500 dark:text-blue-400 text-xs font-semibold font-mono mb-6">
        {badge}
      </div>

      <!-- Adaptive Title Gradient supporting both modes natively -->
      <h1 class="font-display text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-slate-900 via-slate-800 to-blue-600 dark:from-slate-100 dark:via-slate-200 dark:to-blue-300 mb-6 leading-tight">
        {title}
      </h1>

      <!-- Metadata -->
      <div class="flex flex-wrap items-center text-slate-500 text-xs font-mono mb-10 gap-x-4 gap-y-2 border-b border-cyber-border/40 pb-4">
        <span class="text-slate-700 dark:text-slate-300 font-semibold">Por Cristian Castillo</span>
        <span>•</span>
        <span>{formattedDate}</span>
        {category && (
          <>
            <span>•</span>
            <span class="text-blue-500 dark:text-blue-400 font-bold uppercase">{category}</span>
          </>
        )}
      </div>

      <!-- Content Body formatted with customized typography -->
      <div class="prose prose-invert max-w-none 
                  prose-headings:text-slate-100 prose-headings:font-display prose-headings:font-bold
                  prose-p:text-slate-300 prose-p:leading-relaxed prose-p:font-light prose-p:mb-6 prose-p:text-base md:prose-p:text-lg
                  prose-strong:text-slate-100 prose-strong:font-semibold
                  prose-code:text-cyan-400 prose-code:bg-cyan-500/10 prose-code:border prose-code:border-cyan-500/20 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none prose-code:font-mono prose-code:text-sm
                  prose-a:text-blue-400 prose-a:no-underline hover:prose-a:text-cyan-400 hover:prose-a:underline prose-a:transition-colors
                  prose-pre:border prose-pre:border-cyber-border/60 prose-pre:bg-cyber-card/30 prose-pre:p-4 prose-pre:rounded-xl">
        <slot />
      </div>
    </article>
  </main>
</Layout>

<style is:global>
  /* Cyber styling enhancements for elements inside the markdown prose */
  
  /* Style lists with beautiful custom blue bullets */
  .prose ul {
    list-style-type: none;
    padding-left: 0 !important;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose ul > li {
    position: relative;
    padding-left: 1.5rem !important;
    margin-bottom: 0.75rem;
    color: #cbd5e1; /* slate-300 */
    font-weight: 300; /* light */
  }
  .prose ul > li::before {
    content: "";
    position: absolute;
    left: 0.25rem;
    top: 0.625rem;
    width: 0.375rem;
    height: 0.375rem;
    background-color: #3b82f6; /* cyber blue */
    border-radius: 9999px;
  }

  /* Custom blockquote styling for "Action Box / Next steps" */
  .prose blockquote {
    position: relative;
    overflow: hidden;
    background: linear-gradient(to right, rgba(59, 130, 246, 0.1), rgba(6, 182, 212, 0.05));
    backdrop-filter: blur(4px);
    border-left: 4px solid #3b82f6 !important;
    border-radius: 0 1rem 1rem 0;
    padding: 1.5rem !important;
    margin: 2.5rem 0 !important;
    font-style: normal;
    color: #cbd5e1; /* slate-300 default */
  }
  .prose blockquote h3 {
    margin-top: 0 !important;
    margin-bottom: 0.5rem !important;
    color: #f1f5f9 !important; /* slate-100 */
    font-size: 1.25rem;
  }
  .prose blockquote p {
    margin-bottom: 0 !important;
    font-size: 0.875rem !important;
  }

  /* Inline code highlight */
  .prose :not(pre) > code {
    color: #06b6d4 !important; /* cyber cyan */
    background-color: rgba(6, 182, 212, 0.08) !important;
    border: 1px solid rgba(6, 182, 212, 0.2) !important;
  }
</style>
